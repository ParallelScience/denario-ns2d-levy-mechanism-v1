    plt.title('Conditional MSD: Vortex vs Strain')
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    filepath_msd = os.path.join(data_dir, 'conditional_msd_1_' + timestamp + '.png')
    plt.savefig(filepath_msd, dpi=300)
