engineer (to main_cmbagent_chat):

**Code Explanation:**

The script performs the first step of the analysis by computing global Lagrangian statistics from the provided tracer trajectories. 
1. **Unrolling Trajectories**: The periodic trajectories (domain $[0, 2\pi]$) are unrolled into continuous absolute positions. Any jump larger than $\pi$ between consecutive time steps is identified as a periodic boundary crossing and corrected by adding or subtracting $2\pi$.
2. **Mean Squared Displacement (MSD)**: The MSD is computed for a logarithmically spaced set of time lags $\tau$. The anomalous diffusion exponent $H$ is estimated by performing a log-log linear fit of the MSD versus $\tau$ in the intermediate asymptotic regime ($\tau \in [10, 100]$).
3. **Stable Index $\alpha(\tau)$**: For each lag $\tau$, the characteristic function of the displacements $\phi(k) = \langle \cos(k \Delta x) \rangle$ is computed. By fitting $-\ln(\phi(k))$ to $|D k|^\alpha$ in log-log space for a suitable range of $k$, the stable index $\alpha(\tau)$ is estimated. This captures the transition from Gaussian ($\alpha \approx 2$) to heavy-tailed ($\alpha < 2$) behavior.
4. **Tail Exponent**: To cross-validate the characteristic function fit, the far tail (top 5%) of the displacement distribution is fitted to a power law using a log-log fit of the histogram, yielding an alternative estimate of the stable index $\alpha_{tail}$.
5. **Lagrangian Velocity Autocorrelation**: Lagrangian velocities are computed using finite differences of the unrolled trajectories. The velocity autocorrelation function $R_v(\tau)$ is then calculated, and its decorrelation time is estimated by integrating $R_v(\tau)$ up to its first zero-crossing.
6. **Data Saving**: All computed metrics, including unrolled trajectories, velocities, MSD, $\alpha(\tau)$, $R_v(\tau)$, and representative displacement PDFs, are saved to the `data/` directory for use in subsequent steps.

**Python Code:**

```python
import numpy as np
import os

def compute_alpha_cf(dx, num_k=50):
    """
    Computes the stable index alpha by fitting the characteristic function of displacements.
    """
    dx = dx.flatten()
    dx = dx[~np.isnan(dx)]
    if len(dx) == 0:
        return np.nan, np.nan
        
    med_dx = np.median(np.abs(dx))
    if med_dx == 0:
        return np.nan, np.nan
        
    # Choose a range of k such that k * dx is around 1
    k_max = max(2.0 / med_dx, 1e-2)
    ks = np.logspace(-3, np.log10(k_max), num_k)
    
    phi = np.zeros(num_k)
    for j, k in enumerate(ks):
        phi[j] = np.mean(np.cos(k * dx))
        
    # Use only the reliable part of the characteristic function
    valid = (phi > 0.1) & (phi < 0.99)
    if np.sum(valid) < 3:
        return np.nan, np.nan
    
    ks_valid = ks[valid]
    phi_valid = phi[valid]
    
    y = -np.log(phi_valid)
    log_k = np.log(ks_valid)
    log_y = np.log(y)
    
    # Fit log(-ln(phi)) = alpha * log(k) + alpha * log(D)
    p = np.polyfit(log_k, log_y, 1)
    alpha = p[0]
    D = np.exp(p[1] / alpha) if alpha != 0 else 0
    return alpha, D

def compute_tail_exponent_loglog(dx):
    """
    Computes the tail exponent of the displacement PDF using a log-log fit of the histogram tail.
    """
    dx = np.abs(dx.flatten())
    dx = dx[~np.isnan(dx)]
    if len(dx) == 0:
        return np.nan
        
    # Focus on the far tail (top 5% of displacements)
    threshold = np.percentile(dx, 95)
    tail = dx[dx > threshold]
    if len(tail) < 10:
        return np.nan
    
    counts, bin_edges = np.histogram(tail, bins=50, density=True)
    bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2
    
    valid = counts > 0
    if np.sum(valid) < 3:
        return np.nan
        
    log_x = np.log(bin_centers[valid])
    log_y = np.log(counts[valid])
    
    # Fit log(P) = -mu * log(x) + C
    p = np.polyfit(log_x, log_y, 1)
    mu = -p[0]
    
    # For a Levy stable distribution, the tail falls off as x^(-1-alpha)
    alpha_tail = mu - 1
    return alpha_tail

if __name__ == '__main__':
    # File paths
    traj_x_path = '/home/node/work/projects/ns2d_levy_v1/data/traj_x.npy'
    traj_y_path = '/home/node/work/projects/ns2d_levy_v1/data/traj_y.npy'
    t_traj_path = '/home/node/work/projects/ns2d_levy_v1/data/t_traj.npy'
    
    data_dir = 'data/'
    
    print("Loading trajectories...")
    traj_x = np.load(traj_x_path)
    traj_y = np.load(traj_y_path)
    t_traj = np.load(t_traj_path)
    
    print("Unrolling trajectories...")
    # Unroll X
    dx_raw = np.diff(traj_x, axis=0)
    dx_raw[dx_raw > np.pi] -= 2 * np.pi
    dx_raw[dx_raw < -np.pi] += 2 * np.pi
    unrolled_x = np.vstack([traj_x[0], traj_x[0] + np.cumsum(dx_raw, axis=0)])
    
    # Unroll Y
    dy_raw = np.diff(traj_y, axis=0)
    dy_raw[dy_raw > np.pi] -= 2 * np.pi
    dy_raw[dy_raw < -np.pi] += 2 * np.pi
    unrolled_y = np.vstack([traj_y[0], traj_y[0] + np.cumsum(dy_raw, axis=0)])
    
    dt = t_traj[1] - t_traj[0]
    N_steps = len(t_traj)
    
    print("Computing MSD, alpha(tau), and tail exponents...")
    lags = np.unique(np.logspace(0, np.log10(N_steps // 2), 50).astype(int))
    tau_msd = lags * dt
    
    msd = np.zeros(len(lags))
    alphas_cf = np.zeros(len(lags))
    alphas_tail = np.zeros(len(lags))
    disp_pdfs = {}
    
    indices_to_save = [0, len(lags)//4, len(lags)//2, 3*len(lags)//4, len(lags)-1]
    
    for i, lag in enumerate(lags):
        if i % 10 == 0:
            print("  Processing lag " + str(lag) + " (" + str(i) + "/" + str(len(lags)) + ")")
            
        dx = unrolled_x[lag:] - unrolled_x[:-lag]
        dy = unrolled_y[lag:] - unrolled_y[:-lag]
        
        msd[i] = np.mean(dx**2 + dy**2)
        
        # Combine dx and dy for better statistics, assuming isotropy
        disp = np.concatenate([dx.flatten(), dy.flatten()])
        
        a_cf, _ = compute_alpha_cf(disp)
        a_tail = compute_tail_exponent_loglog(disp)
        
        alphas_cf[i] = a_cf
        alphas_tail[i] = a_tail
        
        if i in indices_to_save:
            counts, bin_edges = np.histogram(disp, bins=100, density=True)
            disp_pdfs[f'lag_{lag}'] = {'counts': counts, 'bin_edges': bin_edges, 'tau': tau_msd[i]}
            
    # Fit MSD to find H in the intermediate asymptotic regime
    valid_msd = (tau_msd > 10) & (tau_msd < 100)
    if np.sum(valid_msd) > 5:
        p_msd = np.polyfit(np.log(tau_msd[valid_msd]), np.log(msd[valid_msd]), 1)
        gamma = p_msd[0]
        H = gamma / 2
    else:
        H = np.nan
        
    print("Computing Lagrangian velocities...")
    vx = np.diff(unrolled_x, axis=0) / dt
    vy = np.diff(unrolled_y, axis=0) / dt
    
    print("Computing velocity autocorrelation...")
    lags_v = np.unique(np.logspace(0, np.log10(len(vx) // 2), 50).astype(int))
    tau_v = lags_v * dt
    rv = np.zeros(len(lags_v))
    
    vx_fluct = vx - np.mean(vx)
    vy_fluct = vy - np.mean(vy)
    var_v = np.mean(vx_fluct**2 + vy_fluct**2)
    
    for i, lag in enumerate(lags_v):
        cov = np.mean(vx_fluct[lag:] * vx_fluct[:-lag] + vy_fluct[lag:] * vy_fluct[:-lag])
        rv[i] = cov / var_v
        
    # Decorrelation time (integrate up to the first zero crossing)
    zero_crossings = np.where(rv < 0)[0]
    if len(zero_crossings) > 0:
        first_zero = zero_crossings[0]
        if first_zero > 0:
            decorr_time = np.trapz(rv[:first_zero], tau_v[:first_zero])
        else:
            decorr_time = 0.0
    else:
        decorr_time = np.trapz(rv, tau_v)
    
    print("\n--- Key Numerical Results ---")
    print("MSD exponent H (from log-log fit, tau in [10, 100]): " + str(H))
    print("Decorrelation time of R_v: " + str(decorr_time))
    print("\nStable index alpha(tau) at selected lags:")
    for i in indices_to_save:
        print("  tau = " + str(tau_msd[i]) + ": alpha_cf = " + str(alphas_cf[i]) + ", alpha_tail = " + str(alphas_tail[i]))
        
    print("\nSaving results to disk...")
    np.savez(os.path.join(data_dir, 'unrolled_traj.npz'), unrolled_x=unrolled_x, unrolled_y=unrolled_y, t_traj=t_traj)
    np.savez(os.path.join(data_dir, 'velocities.npz'), vx=vx, vy=vy, t_v=t_traj[:-1])
    np.savez(os.path.join(data_dir, 'msd.npz'), tau=tau_msd, msd=msd)
    np.savez(os.path.join(data_dir, 'alpha_tau.npz'), tau=tau_msd, alpha_cf=alphas_cf, alpha_tail=alphas_tail)
    np.savez(os.path.join(data_dir, 'rv_tau.npz'), tau=tau_v, rv=rv)
    
    # Flatten the dictionary for safe saving
    disp_pdfs_flat = {}
    for k, v in disp_pdfs.items():
        disp_pdfs_flat[k + '_counts'] = v['counts']
        disp_pdfs_flat[k + '_bin_edges'] = v['bin_edges']
        disp_pdfs_flat[k + '_tau'] = v['tau']
    np.savez(os.path.join(data_dir, 'disp_pdfs.npz'), **disp_pdfs_flat)
    
    print("All tasks completed successfully.")
