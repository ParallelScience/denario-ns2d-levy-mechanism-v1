        ax.set_ylabel('MSD')
        ax.set_title('Original vs Surrogate MSD')
        ax.grid(True, which="both", ls="--")
        ax.legend()
        fig.tight_layout()
        filename = os.path.join(data_dir, "surrogate_msd_7_" + str(timestamp) + ".png")
