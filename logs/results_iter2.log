        k_ref_ens = np.arange(6, 20)
        if len(k_ref_ens) > 0 and len(E_k_avg) > 6 and E_k_avg[6] > 0:
            ref_ens = E_k_avg[6] * (k_ref_ens / 6.0)**(-5/3)
            ax.plot(k_ref_ens, ref_ens, 'g--', label='k^-5/3 (Enstrophy Cascade)')
            
        ax.set_xscale('log')
        ax.set_yscale('log')
